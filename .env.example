# Telegram bot token from @BotFather (server-side only)
BOT_TOKEN=PASTE_BOT_TOKEN_FROM_BOTFATHER

# Supabase project Data API URL, e.g. https://abcdefg.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Current Supabase secret key (sb_secret_...). Server-side only.
SUPABASE_SECRET_KEY=PASTE_SUPABASE_SECRET_KEY

# Legacy alternative if your project only has the old service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=PASTE_LEGACY_SERVICE_ROLE_KEY
